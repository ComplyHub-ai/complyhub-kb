# OpenRouter API Configuration
# DO NOT COMMIT THIS FILE (see .gitignore belt in complyhub-kb/.gitignore)
#
# Setup:
# 1. Get your API key from https://openrouter.ai/keys
# 2. Copy this file to openrouter.env (will be ignored by git)
# 3. Replace sk-or-v1-REPLACE_ME with your actual key
# 4. Load with: source .secrets/load-openrouter.sh

OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_SITE_URL=https://complyhub.ai
OPENROUTER_SITE_NAME=ComplyHub RTO Compass
